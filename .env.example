# All optional. Copy to .env.local for local development, or add in Vercel → Project → Settings → Environment Variables.

# Email quote requests straight to the inbox (https://resend.com). Without it, the form opens the visitor's email app instead.
RESEND_API_KEY=
QUOTE_TO_EMAIL=admin@dualnature.co.za
# Must be a sender on a domain verified in Resend, e.g. "Dual Nature Website <quotes@dualnature.co.za>"
QUOTE_FROM_EMAIL=

# Shared rate limiting across serverless instances (https://upstash.com). Without it, limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
